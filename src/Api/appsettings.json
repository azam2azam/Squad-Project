{
  "ConnectionStrings": {
    "Default": "Server=localhost\\SQLEXPRESS;Database=SquadStatusBoard;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "Database": {
    "Provider": "SqlServer",
    "AutoMigrate": false,
    "SeedAdminUser": true,
    "SeedDemoData": false,
    "AdminEmail": "admin@pirt.example",
    "AdminDisplayName": "Administrator",
    "AdminPassword": ""
  },
  "Jwt": {
    "Issuer": "squad-status-board",
    "Audience": "squad-status-board-web",
    "Authority": "",
    "SigningKey": "",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 14
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4220" ]
  },
  "Jira": {
    "Enabled": false,
    "BaseUrl": "",
    "Email": "",
    "ApiToken": ""
  },
  "Export": {
    "Enabled": false,
    "ChromiumPath": "",
    "SlideBaseUrl": "http://localhost:4220",
    "Scale": 2
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "AllowedHosts": "*"
}
