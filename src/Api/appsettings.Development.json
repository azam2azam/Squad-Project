{
  "Database": {
    "AutoMigrate": true,
    // An administrator is created only when the database has no users at all, so a
    // fresh install can be signed into. Set Database__AdminPassword to something real.
    "SeedAdminUser": true,
    // Example boards and roster. Off: a clean application is the default. Turn this on
    // if you want the OPD Screen Revamp demo content back.
    "SeedDemoData": false
  },
  "Jwt": {
    // Development-only key so the app runs out of the box. Production MUST supply its
    // own via Jwt__SigningKey (environment variable or K8s secret) — startup fails if
    // it is missing or shorter than 32 characters.
    "SigningKey": "dev-only-signing-key-not-for-production-use-32+chars"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Information"
      }
    }
  }
}
